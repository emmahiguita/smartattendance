# â”€â”€â”€ SmartAttendance API â€” Variables de entorno â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Copiar este archivo a .env y completar los valores antes de iniciar el servidor.
# NUNCA subir .env al repositorio.

# App
APP_NAME="SmartAttendance API"
APP_VERSION="1.0.0"
DEBUG=False                        # True solo en desarrollo local

# Database
# SQLite (desarrollo): sqlite:///./smartattendance.db
# PostgreSQL (producciÃ³n): postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./smartattendance.db
DB_ECHO=False                      # True para loguear queries SQL (solo dev)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
SQLITE_BUSY_TIMEOUT_MS=5000

# Security â€” generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAR_POR_SECRETO_ALEATORIO_DE_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60    # 60 min para producciÃ³n; 1440 (24h) para dev
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS â€” separar con coma si se pasan mÃºltiples como string (o configurar en config.py)
# Agregar la URL de producciÃ³n del frontend aquÃ­

# Google Sheets (opcional)
# Colocar el archivo de credenciales de la cuenta de servicio en el directorio raÃ­z
# del backend con el nombre: google_credentials.json
GOOGLE_SHEET_NAME=Asistencias_SmartAttendance


